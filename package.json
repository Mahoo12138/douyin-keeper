{
  "name": "douyin-keeper",
  "version": "0.1.0",
  "private": true,
  "description": "Douyin Keeper Next (抖音火花助手) — multi-account Douyin spark-maintenance tool",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @douyin-keeper/web dev",
    "build:web": "pnpm --filter @douyin-keeper/web build",
    "build:spa": "pnpm build:web && node scripts/stage-webassets.mjs",
    "typecheck": "pnpm -r typecheck",
    "contracts:check": "node packages/contracts/validate.mjs",
    "deployment:check": "node scripts/validate-deployment.mjs",
    "test:env": "bash scripts/start-test-env.sh",
    "test:contracts": "pnpm contracts:check",
    "test:backend": "go -C backend test ./...",
    "test:sidecar": "npm --prefix sidecars/playwright-node test",
    "test:web": "pnpm --filter @douyin-keeper/sdk-ts test && pnpm --filter @douyin-keeper/web test",
    "test": "pnpm test:contracts && pnpm test:backend && pnpm test:sidecar && pnpm test:web"
  }
}
