# Images
KEEPER_BACKEND_IMAGE=douyin-keeper/backend:local
KEEPER_WORKER_IMAGE=douyin-keeper/worker:local
KEEPER_HTTP_PORT=8080
# Comma-separated CIDRs/IPs of immediate reverse-proxy peers. Leave empty
# when clients connect directly; forwarded headers are then ignored.
TRUSTED_PROXY_CIDRS=
METRICS_ADDR=:9090

# PostgreSQL
POSTGRES_VERSION=17-alpine
POSTGRES_DB=douyin_keeper
POSTGRES_USER=keeper
POSTGRES_PASSWORD=change-me

# Redis
REDIS_VERSION=8-alpine

# Application secrets — generate unique high-entropy values
AUTH_SIGNING_KEY=
AUTH_REFRESH_PEPPER=
SESSION_MASTER_KEY=
CARD_CODE_PEPPER_DK1=

# WeChat Mini Program
WECHAT_APP_ID=
WECHAT_APP_SECRET=
