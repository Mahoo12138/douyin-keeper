# Copy to the repository root as .env for self-hosted deployment.
# Keep this template in sync with the root .env.example.

KEEPER_BACKEND_IMAGE=douyin-keeper/backend:local
KEEPER_WORKER_IMAGE=douyin-keeper/worker:local
KEEPER_HTTP_PORT=8080
TRUSTED_PROXY_CIDRS=
METRICS_ADDR=:9090

POSTGRES_VERSION=17-alpine
POSTGRES_DB=douyin_keeper
POSTGRES_USER=keeper
POSTGRES_PASSWORD=change-me

REDIS_VERSION=8-alpine

# --- Application secrets: generate unique high-entropy values ---
# AUTH_SIGNING_KEY: 64 hex chars (32 bytes), HS256 signing key.
# AUTH_REFRESH_PEPPER: keyed-hash pepper for refresh tokens / link codes.
# SESSION_MASTER_KEY: 64 hex chars (32 bytes), AES-256-GCM account sessions.
# CARD_CODE_PEPPER_DK1: HMAC pepper for DK1 card codes (independent key).
AUTH_SIGNING_KEY=
AUTH_REFRESH_PEPPER=
SESSION_MASTER_KEY=
CARD_CODE_PEPPER_DK1=

# --- Worker runtime (optional local overrides) ---
SESSION_TEMP_DIR=/tmp/douyin-keeper/session
LOGIN_PROFILE_DIR=/tmp/douyin-keeper/login
PLAYWRIGHT_SIDECAR_COMMAND=node
PLAYWRIGHT_SIDECAR_SCRIPT=sidecars/playwright-node/sidecar.mjs
# Optional local Chromium/Chrome/Edge executable; leave empty in the worker image.
PLAYWRIGHT_EXECUTABLE_PATH=
# Keep headless in services; set to 0 for local manual Douyin verification.
PLAYWRIGHT_HEADLESS=1
PROTOCOL_SIDECAR_COMMAND=node
PROTOCOL_SIDECAR_BUNDLE_DIR=
WORKER_BROWSER_CONCURRENCY=3
MAX_GLOBAL_BROWSERS=3
BROWSER_SEMAPHORE_TTL=2m

# --- Queue / scheduler runtime (optional local overrides) ---
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=5s
SCHEDULE_BATCH_SIZE=100
SCHEDULE_INTERVAL=30s

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_NOTIFICATION_TEMPLATE_ID=
WECHAT_NOTIFICATION_PAGE=pages/index/index
WECHAT_NOTIFICATION_TITLE_FIELD=thing1
WECHAT_NOTIFICATION_BODY_FIELD=thing2
