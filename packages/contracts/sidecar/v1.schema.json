{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://douyin-keeper.local/contracts/sidecar-protocol-v1.schema.json",
  "title": "Douyin Keeper Sidecar Protocol v1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "request_id", "op", "deadline_ms", "input"],
      "properties": {
        "protocol_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1},
        "op": {
          "type": "string",
          "enum": [
            "health.check",
            "login.qr.start",
            "login.qr.poll",
            "login.sms.start",
            "login.sms.verify",
            "session.validate",
            "conversations.list",
            "conversations.archive",
            "message.send_text",
            "message.send_sticker",
            "message.send_first"
          ]
        },
        "deadline_ms": {"type": "integer", "minimum": 1000, "maximum": 300000},
        "input": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "login.qr.start"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/loginQRStartInput"}}}
        },
        {
          "if": {"properties": {"op": {"const": "login.qr.poll"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/loginQRPollInput"}}}
        },
        {
          "if": {"properties": {"op": {"const": "login.sms.start"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/loginSMSStartInput"}}}
        },
        {
          "if": {"properties": {"op": {"const": "login.sms.verify"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/loginSMSVerifyInput"}}}
        },
        {
          "if": {"properties": {"op": {"const": "session.validate"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/sessionValidateInput"}}}
        },
        {
          "if": {"properties": {"op": {"const": "conversations.list"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/conversationsListInput"}}}
        },
        {
          "if": {"properties": {"op": {"const": "conversations.archive"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/conversationsArchiveInput"}}}
        },
        {
          "if": {"properties": {"op": {"const": "message.send_text"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/messageSendTextInput"}}}
        },
        {
          "if": {"properties": {"op": {"const": "message.send_sticker"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/messageSendStickerInput"}}}
        },
        {
          "if": {"properties": {"op": {"const": "message.send_first"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/messageSendFirstInput"}}}
        }
      ]
    },
    "sessionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"const": "playwright_storage_state_file"},
        "path": {"type": "string", "minLength": 1},
        "profile_dir": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/",
      "not": {"enum": ["/", "/tmp", "/run"]}
    },
    "loginQRStartInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_dir"],
      "properties": {
        "profile_dir": {"$ref": "#/$defs/absolutePath"},
        "locale": {"type": "string", "minLength": 1, "maxLength": 32, "default": "zh-CN"},
        "force_login": {"type": "boolean", "default": false}
      }
    },
    "loginQRPollInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login_handle"],
      "properties": {
        "login_handle": {"type": "string", "minLength": 1, "maxLength": 128},
        "export_session_file": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "loginSMSStartInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_dir", "phone"],
      "properties": {
        "profile_dir": {"$ref": "#/$defs/absolutePath"},
        "phone": {"type": "string", "minLength": 5, "maxLength": 32},
        "locale": {"type": "string", "minLength": 1, "maxLength": 32, "default": "zh-CN"},
        "force_login": {"type": "boolean", "default": false}
      }
    },
    "loginSMSVerifyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login_handle", "code"],
      "properties": {
        "login_handle": {"type": "string", "minLength": 1, "maxLength": 128},
        "code": {"type": "string", "pattern": "^[0-9]{4,8}$"},
        "export_session_file": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "sessionValidateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session"],
      "properties": {
        "session": {"$ref": "#/$defs/sessionRef"},
        "validation_level": {"const": "basic", "default": "basic"}
      }
    },
    "existingConversationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_user_id", "platform_conversation_id"],
      "properties": {
        "platform_user_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "platform_conversation_id": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "textMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "conversationsListInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session"],
      "properties": {
        "session": {"$ref": "#/$defs/sessionRef"},
        "cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 100}
      }
    },
    "conversationsArchiveInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "target", "archived"],
      "properties": {
        "session": {"$ref": "#/$defs/sessionRef"},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform_conversation_id"],
          "properties": {
            "platform_user_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "platform_conversation_id": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        },
        "archived": {"type": "boolean"}
      }
    },
    "messageSendTextInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "target", "message"],
      "properties": {
        "session": {"$ref": "#/$defs/sessionRef"},
        "target": {"$ref": "#/$defs/existingConversationTarget"},
        "message": {"$ref": "#/$defs/textMessage"}
      }
    },
    "messageSendStickerInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "target", "message"],
      "properties": {
        "session": {"$ref": "#/$defs/sessionRef"},
        "target": {"$ref": "#/$defs/existingConversationTarget"},
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sticker_id"],
          "properties": {
            "sticker_id": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        }
      }
    },
    "messageSendFirstInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "target", "message"],
      "properties": {
        "session": {"$ref": "#/$defs/sessionRef"},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform_user_id"],
          "properties": {
            "platform_user_id": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 2000}
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "message": {"type": "string"},
        "detail": {"type": "object"}
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "adapter_version", "duration_ms"],
      "properties": {
        "adapter": {"type": "string"},
        "adapter_version": {"type": "string"},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "request_id", "ok", "result", "meta"],
      "properties": {
        "protocol_version": {"const": 1},
        "request_id": {"type": "string"},
        "ok": {"const": true},
        "result": {"type": "object"},
        "meta": {"$ref": "#/$defs/meta"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "request_id", "ok", "error", "meta"],
      "properties": {
        "protocol_version": {"const": 1},
        "request_id": {"type": "string"},
        "ok": {"const": false},
        "error": {"$ref": "#/$defs/error"},
        "meta": {"$ref": "#/$defs/meta"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/failure"}
  ]
}
